<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PartnerCard.Web</RootNamespace>
  </PropertyGroup>

  <!--
    Test chạm được lớp nội bộ, không phải mở public chỉ để kiểm thử (SPEC mục 2).
    Bộ đo (T-08) cũng ở đây vì nó cần TextKeys.Collapse để so trường chữ theo luật
    SPEC mục 14 ("gộp khoảng trắng, bỏ dấu chấm cuối") — mở public một hàm chỉ để
    một công cụ nội bộ dùng thì đắt hơn là thêm một dòng ở đây.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="PartnerCard.Tests" />
    <InternalsVisibleTo Include="PartnerCard.Eval" />
  </ItemGroup>

  <!--
    Bảng đáp án chỉ có một bản duy nhất, ở tests/ (SPEC mục 2: nó thuộc Code\ vì FakeExtractor
    đọc nó lúc chạy). Chép sang output để chế độ fake chạy được dù working directory là đâu.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\tests\PartnerCard.Tests\TestData\cards\expected.json"
          Link="fakedata\expected.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Dữ liệu mồi (SPEC mục 19.3). Nguồn duy nhất ở Code\data\, git theo dõi — .gitignore chỉ chặn
    partners.json, counter.json và images/. Chép sang output để chạy được dù working directory là
    đâu, và CopyToPublishDirectory để nó đi cùng bản publish: trên máy chủ, đĩa bắt đầu rỗng nên
    không có file mồi thì trang danh sách trống trơn.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\data\partners.seed.json"
          Link="seeddata\partners.seed.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    appsettings.Development.json chứa GEMINI_API_KEY. .gitignore chỉ chặn git — nó không chặn
    publish, và SDK Web mặc định chép mọi appsettings.*.json vào bản publish. Không có dòng này thì
    khoá nằm trong bản publish, tức trong image đẩy lên máy chủ (SPEC mục 13).

    Chế độ Production không NẠP file đó, nhưng không nạp không có nghĩa là không chép lên.
  -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- SPEC mục 1 ghim đúng 2.2.0. Bản này mặc định Stateless — xem BACKLOG T-10. -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

</Project>
